# Copy to .env and fill in real values before `docker compose up`.
# Every value here maps directly to app/core/config.py's Settings fields
# (pydantic-settings reads .env automatically).

ENVIRONMENT=production

# Compose's `db`/`redis` service names resolve inside the Docker network;
# use localhost/127.0.0.1 instead if running the app outside Docker.
POSTGRES_USER=options_trading
POSTGRES_PASSWORD=change_me
POSTGRES_DB=options_trading
DATABASE_URL=postgresql+asyncpg://options_trading:change_me@db:5432/options_trading
REDIS_URL=redis://redis:6379/0

# IBKR TWS/Gateway -- PAPER account only for Phase 8 (docs/PAPER_TRADING_PLAN_V0.1.md).
# host.docker.internal works from inside Docker on Mac/Windows to reach TWS
# running on the host machine; on Linux use the host's real LAN/VPN address,
# or point at the optional `ib-gateway` compose service (see docker-compose.yml).
IBKR_HOST=host.docker.internal
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Symbols the scanner service tracks (space-separated) -- see the
# commented-out `scanner` service in docker-compose.yml.
SCANNER_SYMBOLS=NVDA AMD

# Only needed if you enable the optional ib-gateway compose service.
# IBKR_USERID=
# IBKR_PASSWORD=
