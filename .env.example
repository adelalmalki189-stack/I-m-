# Copy to .env and fill in real values. Every value maps to app/core/config.py's Settings.
# Production: copy to the server's deploy folder next to deploy/docker-compose.prod.yml.

ENVIRONMENT=production

# Production stack (deploy/docker-compose.prod.yml)
DOMAIN=bud.example.com
BUD_IMAGE=ghcr.io/your-github-user/bud
BUD_VERSION=latest
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=0
SENTRY_DSN=

# The compose `db` service name resolves inside the Docker network;
# use localhost instead if running the app outside Docker.
POSTGRES_USER=bud
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bud
DATABASE_URL=postgresql+asyncpg://bud:change_me@db:5432/bud

# Email delivery for insurer quotation requests.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@example.com
SMTP_USE_TLS=true

# Staff login sessions. Must be true whenever the app is served over HTTPS (production).
SESSION_COOKIE_SECURE=true
SESSION_HOURS=12

# First manager account (run once after migrations):
#   docker compose run --rm -e BUD_ADMIN_PASSWORD='...' app python -m app.cli create-manager --email you@example.com --name "اسمك"

# IP of the reverse proxy in front of the app (comma-separated, or * inside a private network).
# Lets the app see each customer's real IP for the portal and login limits.
FORWARDED_ALLOW_IPS=127.0.0.1

# Customer messaging (Phase 4). Leave empty to stay in sandbox mode — messages are
# recorded in the system but not sent. Switch to live in Settings → Automation.
# WhatsApp Business Cloud API (Meta):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=ar
# Unifonic SMS (sender ID registered with CST):
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=

# Insurer replies mailbox (IMAP over SSL). The worker reads unseen messages every 2 minutes.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# AI quote extraction: sends insurer emails and their attachments (which may include customer
# data) to the Anthropic API. Enable only after approving that data flow (PDPL).
AI_QUOTE_EXTRACTION_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
